---
const links = [
  { name: "GitHub", href: "https://github.com/PabloAML1" },
  { name: "LinkedIn", href: "https://www.linkedin.com/in/pablo-montero-lopez/" },
  { name: "WhatsApp", href: "https://wa.me/593984398542" },
  { name: "Teléfono", key: "contact.phone", href: "tel:+593984398542" },
  { name: "CV", href: "/CV_Pablo.pdf" },
];
const web3FormsKey = "a7cf6273-1e68-4538-9f34-12315cb198b2";
---
<section id="contact" class="section-space" data-contact aria-labelledby="contact-title">
  <div class="site-frame contact-content">
    <div class="contact-layout">
      <div data-contact-intro>
        <p class="eyebrow" data-i18n="contact.label">Contáctame</p>
        <h2 id="contact-title" class="display section-title" data-i18n-html="contact.title">Trabajemos <span>juntos</span></h2>
        <p class="section-description" data-i18n="contact.description">Siempre estoy abierto a conversar sobre nuevos proyectos, ideas creativas u oportunidades para ser parte de tu visión.</p>
        <a class="contact-email" href="mailto:monteropablo511@gmail.com">monteropablo511@gmail.com <span aria-hidden="true">↗</span></a>
        <ul class="contact-links">
          {links.map(({ name, href, key }) => (
            <li><a class="line-link" href={href} target={href.startsWith("tel:") ? undefined : "_blank"} rel="noopener noreferrer"><span data-i18n={key}>{name}</span> <span aria-hidden="true">↗</span></a></li>
          ))}
        </ul>
      </div>
      <form id="contact-form" class="contact-form" action="https://api.web3forms.com/submit" method="POST">
        <input type="hidden" name="access_key" value={web3FormsKey} />
        <h3 class="display" data-i18n="contact.heading">Hablemos sobre tu proyecto</h3>
        <p class="section-description" data-i18n="contact.subheading">Completa el formulario y te responderé lo antes posible.</p>
        <div class="contact-fields">
          <label><span data-i18n="contact.name">Nombre</span><input name="name" autocomplete="name" placeholder="Tu nombre" data-i18n-placeholder="contact.namePlaceholder" required /></label>
          <label><span data-i18n="contact.email">Correo</span><input name="email" type="email" autocomplete="email" placeholder="tu@correo.com" data-i18n-placeholder="contact.emailPlaceholder" required /></label>
          <label class="contact-wide"><span data-i18n="contact.subject">Asunto</span><input name="subject" placeholder="¿De qué se trata?" data-i18n-placeholder="contact.subjectPlaceholder" required /></label>
          <label class="contact-wide"><span data-i18n="contact.message">Mensaje</span><textarea name="message" rows="3" placeholder="Cuéntame sobre tu proyecto..." data-i18n-placeholder="contact.messagePlaceholder" required></textarea></label>
        </div>
        <button type="submit" class="solid-link"><span data-i18n="contact.send">Enviar mensaje</span> <span aria-hidden="true">↗</span></button>
        <p id="form-status" role="status" aria-live="polite"></p>
      </form>
    </div>
  </div>
  <footer class="contact-footer">
    <div class="site-frame contact-footer-inner">
      <span>© 2026 Pablo Montero</span>
      <span data-i18n="contact.built">Hecho con Astro y React</span>
      <a class="line-link contact-top" href="#inicio"><span data-i18n="contact.backToTop">Volver al inicio</span> <span aria-hidden="true">↑</span></a>
    </div>
  </footer>
</section>

<script>
  import { getTranslation } from "../scripts/i18n";

  const form = document.querySelector<HTMLFormElement>("#contact-form");
  const status = document.querySelector<HTMLElement>("#form-status");
  const submit = form?.querySelector<HTMLButtonElement>("[type=submit]");
  if (form && status && submit) {
    const showStatus = (key: string, state: string) => {
      status.dataset.i18n = key;
      status.dataset.state = state;
      status.textContent = getTranslation(key);
    };
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (submit.disabled) return;
      const data = new FormData(form);
      submit.disabled = true;
      showStatus("contact.sending", "waiting");
      try {
        const response = await fetch(form.action, { method: "POST", body: data, headers: { Accept: "application/json" } });
        const result = await response.json();
        if (!response.ok || !result.success) {
          showStatus("contact.failure", "error");
          return;
        }
        form.reset();
        showStatus("contact.success", "success");
      } catch {
        showStatus("contact.connectionError", "error");
      } finally {
        submit.disabled = false;
      }
    });
  }
</script>

<style>
  #contact {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    min-height: 100%;
    padding-block-end: 0;
    background: var(--ink);
  }
  #contact::before {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    z-index: -1;
    height: min(100%, 100svh);
    background: url("/images/creation-of-adam.webp") 38% 45% / cover no-repeat;
    opacity: .15;
    filter: saturate(.65);
    mask-image:
      linear-gradient(90deg, transparent, #000 17% 83%, transparent),
      linear-gradient(180deg, transparent, #000 23% 64%, transparent 96%);
    mask-composite: intersect;
    pointer-events: none;
  }
  :global(.portfolio-viewport:not([data-horizontal])) #contact::before {
    inset-block: 1rem auto;
    height: min(100% - 1rem, 58rem);
    mask-image: var(--section-fade-block), linear-gradient(to right, transparent, black 18% 82%, transparent);
  }
  .contact-content { padding-block-end: clamp(1.8rem, 5svh, 4rem); }
  #contact h2 :global(span) { color: var(--gold); font-style: italic; }
  .contact-layout { display: grid; grid-template-columns: minmax(0,1.1fr) minmax(0,.9fr); gap: clamp(2rem,7vw,7rem); }
  .contact-email { display: inline-block; max-width: 100%; overflow-wrap: anywhere; color: var(--gold); font-family: var(--display); font-size: clamp(1.55rem,3.25vw,3.1rem); margin-top: 1.5rem; }
  .contact-email:hover { color: var(--paper); }
  .contact-links { display: flex; flex-wrap: wrap; gap: .25rem 1.1rem; margin-top: .85rem; }
  .contact-form { display: grid; align-content: start; justify-items: start; border-block-start: 1px solid var(--rule); padding-block-start: 1rem; gap: .65rem; }
  .contact-form h3 { font-size: clamp(1.8rem,3vw,2.55rem); line-height: 1; }
  .contact-form > p { font-size: .83rem; }
  .contact-fields { width: 100%; display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: .85rem; margin-block: .6rem; }
  .contact-fields label { min-width: 0; display: grid; gap: .38rem; font-size: .76rem; }
  .contact-wide { grid-column: 1/-1; }
  .contact-fields input, .contact-fields textarea { width: 100%; background: var(--surface); border: 1px solid var(--rule); color: var(--paper); padding: .7rem .65rem; font-size: 1rem; }
  .contact-fields input::placeholder, .contact-fields textarea::placeholder { color: #a99d90; font-size: .88rem; }
  .contact-fields textarea { resize: vertical; }
  .contact-form button:disabled { opacity: .65; }
  #form-status[data-state="error"] { color: #f0ac9f; }
  #form-status[data-state="success"] { color: #bdd3ae; }
  .contact-footer { margin-block-start: auto; border-block-start: 1px solid var(--rule); }
  .contact-footer-inner { display: flex; flex-wrap: wrap; gap: .35rem 1rem; justify-content: space-between; padding-block: 1.4rem; color: var(--muted); font-size: .72rem; }
  :global([data-horizontal]) .contact-top { display: none; }
  @media (max-width: 760px) { .contact-layout { grid-template-columns: 1fr; } }
  @media (max-width: 640px) and (orientation: portrait) {
    #contact::before { background-image: url("/images/creation-of-adam-compact.webp"); background-position: center; }
  }
  @media (max-width: 520px) {
    .contact-fields { grid-template-columns: minmax(0, 1fr); }
    .contact-top { flex-basis: 100%; justify-content: flex-start; min-height: 2.75rem; }
  }
</style>
