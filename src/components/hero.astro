---
import SectionRays from "./SectionRays.astro";
import PortraitReveal from "./PortraitReveal.astro";
import Overture from "./Overture.astro";
---

<div class="opening">
  <div class="opening-stage">
    <Overture />
    <section id="hero" class="hero-panel" tabindex="-1" data-hero>
      <SectionRays origin="top-right" />
      <div class="site-frame hero-layout">
        <div class="hero-heading" data-hero-heading>
          <p class="eyebrow availability" data-i18n="hero.availability">Disponible para trabajar</p>
          <h1 class="display">Software<br /><em>Engineer.</em></h1>
        </div>
        <figure class="portrait" data-portrait>
          <PortraitReveal />
        </figure>
        <div class="hero-copy" data-hero-copy>
          <p data-i18n="hero.description">Especializado en crear aplicaciones full-stack escalables. Conecto sistemas backend de alto rendimiento con experiencias frontend inmersivas y cinematográficas.</p>
          <div class="hero-actions">
            <a class="solid-link" href="#projects"><span data-i18n="hero.work">Ver proyectos</span> <span aria-hidden="true">↗</span></a>
            <a class="line-link" href="#contact" data-i18n="hero.contact">Contacto</a>
          </div>
        </div>
      </div>
    </section>
  </div>
  <div class="hero-stop" aria-hidden="true"></div>
</div>

<style>
  .opening, .opening-stage { position: relative; }
  .hero-panel {
    position: relative;
    isolation: isolate;
    background: radial-gradient(ellipse at 100% 0%, #2a1e16 0%, var(--ink) 62%);
    background-color: var(--ink);
    background-size: 100% 100dvh;
    background-repeat: no-repeat;
    padding-block: clamp(3.75rem, 7svh, 5rem) .5rem;
  }
  :global([data-horizontal]) .hero-panel:not([data-light-visible]) :global([data-section-rays]) { display: none; }
  :global(.portfolio-viewport:not([data-horizontal])) .hero-panel { background: var(--ink); }
  .hero-layout {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    align-items: center;
    padding-inline: clamp(1.25rem, 4.5vw, 5.75rem);
  }
  .hero-heading, .hero-copy, .portrait { grid-row: 1; }
  .hero-heading { grid-column: 1 / 6; margin-block-end: clamp(1.5rem, 9svh, 5.5rem); z-index: 1; pointer-events: none; }
  .hero-heading > * { width: fit-content; pointer-events: auto; }
  .hero-heading h1 { font-size: clamp(2.75rem, 8.55vw, 9.5rem); line-height: .83; margin-block-start: .2em; }
  .hero-heading h1 em { color: var(--gold); font-weight: inherit; }
  .hero-copy { grid-column: 9 / -1; margin-block-start: clamp(2rem, 15svh, 9rem); width: min(100%, 18.75rem); z-index: 1; }
  .hero-copy > p { color: var(--paper); line-height: 1.57; font-size: clamp(.88rem, 1.26vw, 1.18rem); text-shadow: 0 1px 12px var(--ink); }
  .hero-actions { display: flex; align-items: center; flex-wrap: wrap; gap: .45rem 1.05rem; margin-top: 1.3rem; }
  .availability::before { content: ''; display: inline-block; width: .42rem; height: .42rem; border-radius: 50%; background: #aabf9b; margin-right: .65rem; vertical-align: .13em; }
  .portrait {
    position: relative;
    inset-block-start: clamp(-3.7rem, -6svh, -2rem);
    grid-column: 3 / 11;
    margin: 0;
    min-width: 0;
    width: min(100%, 77svh, 58vw, calc((100svh - 4.85rem) / 1.17));
    justify-self: center;
  }
  :global([data-horizontal]) .opening { flex: 0 0 calc(2 * var(--slide-width)); scroll-snap-align: start; }
  :global([data-horizontal]) .opening-stage { position: sticky; left: 0; width: var(--slide-width); height: 100%; overflow: clip; }
  :global([data-horizontal]) .hero-panel { height: 100%; overflow-y: auto; }
  :global([data-horizontal]) .hero-layout { min-height: 100%; }
  :global([data-horizontal]) .hero-stop { position: absolute; left: var(--slide-width); top: 0; width: var(--slide-width); height: 1px; scroll-snap-align: start; pointer-events: none; }
  @media (max-width: 1023px), (hover: none) and (pointer: coarse) {
    .hero-layout { grid-template-columns: 1fr; gap: .9rem; text-align: center; }
    .hero-panel { padding-block: clamp(3.75rem, 8vw, 6rem) 3.5rem; }
    .hero-heading, .hero-copy, .portrait { grid-area: auto; margin: 0; }
    .hero-heading > * { margin-inline: auto; }
    .hero-heading h1 { font-size: clamp(3rem, 12vw, 6rem); }
    .hero-copy { width: min(100%, 27rem); justify-self: center; }
    .hero-actions { margin-top: .85rem; justify-content: center; }
    .portrait { inset-block-start: 0; width: min(88%, 28rem, 55svh); }
    .hero-actions a { min-height: 2.75rem; }
  }
</style>
