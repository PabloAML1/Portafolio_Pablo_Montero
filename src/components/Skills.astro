---
import { skills } from "../data/skills";

const first = skills[0];
---
<section id="skills" class="section-space skills" data-skills aria-labelledby="skills-title">
  <div class="site-frame">
    <header class="skills-header" data-skills-header>
      <p class="eyebrow" data-i18n="skills.label">Lo que hago</p>
      <h2 id="skills-title" class="display section-title" data-i18n-html="skills.title">Mis <span>habilidades</span></h2>
      <div class="skills-instructions">
        <p class="section-description skills-hint" id="skills-hint"><span class="keyboard-hint-pointer" data-i18n="skills.keyboardHint">Pasa el cursor, toca una tecla o pulsa su atajo.</span><span class="keyboard-hint-touch" data-i18n="skills.touchHint">Toca una tecla para explorar la tecnología.</span></p>
        <button class="skill-sound" type="button" data-key-sound aria-pressed="true" hidden>
          <span data-i18n="skills.keySound">Sonido de teclas</span>
        </button>
      </div>
    </header>

    <div class="skills-layout">
      <article id="skill-detail" class="skill-detail" data-skill-detail aria-labelledby="skill-name">
        <div class="skill-detail-meta">
          <p class="eyebrow" data-skill-category>{first.categoryTitle}</p>
          <kbd data-skill-shortcut>{first.shortcut}</kbd>
        </div>
        <h3 class="display" id="skill-name" data-skill-name>{first.name}</h3>
        <p class="section-description skill-description" data-skill-description>{first.es}</p>
      </article>
      <div class="keyboard-scene" data-skills-scene>
        <div class="keyboard-body" role="group" aria-labelledby="skills-title" aria-describedby="skills-hint" data-skills-keyboard>
          {skills.map(({ name, logo, color, shortcut }, index) => (
            <button
              type="button"
              class="skill-key"
              data-skill-key={index}
              data-skill-logo={logo}
              style={`--key-color: ${color}`}
              aria-label={name}
              aria-keyshortcuts={shortcut}
              aria-controls="skill-detail"
              aria-pressed={index === 0 ? "true" : "false"}
            >
              <span class="skill-key-mechanism" aria-hidden="true">
                <span class="skill-key-cap">
                  <img src={`/images/skill-logos/${logo}.svg`} alt="" width="40" height="40" loading="lazy" decoding="async" draggable="false" />
                </span>
              </span>
            </button>
          ))}
        </div>
      </div>

      <p class="sr-only" aria-live="polite" data-skill-announcement></p>
    </div>
  </div>
</section>

<script>
  import "../scripts/skills-keyboard";
</script>

<style>
  .skills {
    min-height: 100%;
    --skills-edge: clamp(2.4rem, 12vw, 12rem);
    background:
      linear-gradient(90deg, var(--ink), transparent var(--skills-edge), transparent calc(100% - var(--skills-edge)), var(--ink)),
      radial-gradient(ellipse at 36% 56%, #2b221a, #1a1511 42%, transparent 76%),
      var(--ink);
  }
  :global(.portfolio-viewport:not([data-horizontal])) .skills {
    background:
      linear-gradient(to bottom, var(--ink), transparent 23% 76%, var(--ink)),
      radial-gradient(ellipse at 45% 63%, #2b221a, transparent 71%),
      var(--ink);
  }
  .skills h2 :global(span) { color: var(--gold); font-style: italic; }
  .skills-header .section-title {
    font-size: clamp(3.4rem, min(8vw, 13svh), 7.25rem);
    margin-bottom: .18em;
  }
  .skills-hint { font-size: clamp(.77rem, 1.3vw, .94rem); }
  .skills-instructions { display: flex; align-items: center; flex-wrap: wrap; gap: .35rem 1rem; }
  .skill-sound {
    display: inline-flex;
    align-items: center;
    gap: .45rem;
    min-height: 2rem;
    padding: .2rem .65rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    color: var(--muted);
    font-size: .72rem;
  }
  .skill-sound::before { content: ""; width: .42rem; aspect-ratio: 1; border: 1px solid currentColor; border-radius: 50%; }
  .skill-sound[aria-pressed="true"] { color: var(--gold); }
  .skill-sound[aria-pressed="true"]::before { background: currentColor; }
  .skills-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(13.5rem, .42fr);
    align-items: center;
    gap: clamp(1rem, 4.5vw, 5rem);
    margin-top: clamp(.75rem, 3.25svh, 2.5rem);
  }

  .keyboard-scene {
    --keyboard-columns: 9;
    --keyboard-pitch: 39deg;
    --keyboard-yaw: -10deg;
    --keyboard-roll: -12deg;
    --keyboard-tilt-x: 0deg;
    --keyboard-tilt-y: 0deg;
    min-width: 0;
    padding: clamp(1rem, 4svh, 3.3rem) 3% clamp(1.25rem, 5svh, 4rem);
    perspective: 1150px;
  }
  :global([data-horizontal]) .keyboard-scene { grid-area: 1 / 1; }
  :global([data-horizontal]) .skill-detail { grid-area: 1 / 2; }
  .keyboard-body {
    position: relative;
    display: grid;
    grid-template-columns: repeat(var(--keyboard-columns), minmax(0, 1fr));
    gap: clamp(.2rem, .6vw, .75rem);
    padding: clamp(.55rem, 1.35vw, 1.65rem);
    border: 1px solid #ad8762;
    border-radius: clamp(.6rem, 1.05vw, 1.25rem);
    background: linear-gradient(156deg, #55463a, #2b231e 50%, #201a17);
    box-shadow:
      inset 0 0 0 3px #302721,
      inset 0 1px 0 4px #6d5947,
      0 4px #33261d, 0 8px #261c16, 0 12px #1d1511, 0 15px #15100e,
      0 2.25rem 3rem rgb(0 0 0 / .57);
    transform:
      rotateX(calc(var(--keyboard-pitch) + var(--keyboard-tilt-x)))
      rotateY(calc(var(--keyboard-yaw) + var(--keyboard-tilt-y)))
      rotateZ(var(--keyboard-roll));
    transform-style: preserve-3d;
  }
  .skill-key {
    --cap-light: color-mix(in srgb, var(--key-color) 94%, white);
    --cap-dark: color-mix(in srgb, var(--key-color) 90%, black);
    --cap-wall: color-mix(in srgb, var(--key-color) 77%, black);
    --cap-edge: color-mix(in srgb, var(--key-color) 55%, black);
    --cap-pocket: 3px;
    --cap-height: clamp(8px, 1.2vw, 18px);
    position: relative;
    width: 100%;
    min-height: 2.72rem;
    aspect-ratio: 1.05;
    border-radius: clamp(.3rem, .64vw, .65rem);
    background: #17120f;
    box-shadow: inset 0 1px 4px #090705, 0 1px rgb(255 255 255 / .12);
    transform-style: preserve-3d;
    user-select: none;
    touch-action: manipulation;
  }
  .skill-key::before {
    content: "";
    position: absolute;
    inset: var(--cap-pocket);
    transform: translateZ(var(--cap-height));
  }
  .skill-key-mechanism {
    position: absolute;
    inset: var(--cap-pocket);
    pointer-events: none;
    transform-style: preserve-3d;
    transition: transform .15s cubic-bezier(.2, .7, .35, 1);
    transform: translateZ(0);
  }
  .skill-key-mechanism::before, .skill-key-mechanism::after {
    content: "";
    position: absolute;
    background: linear-gradient(var(--cap-wall), var(--cap-edge));
    backface-visibility: hidden;
  }
  .skill-key-mechanism::before {
    inset: 100% 1px auto;
    height: var(--cap-height);
    border-radius: .15rem .15rem .3rem .3rem;
    transform-origin: center top;
    transform: translateZ(var(--cap-height)) rotateX(-90deg);
  }
  .skill-key-mechanism::after {
    inset: 1px auto 1px 100%;
    width: var(--cap-height);
    border-radius: .24rem .15rem .15rem .24rem;
    transform-origin: left center;
    transform: translateZ(var(--cap-height)) rotateY(90deg);
    background: linear-gradient(to right, var(--cap-wall), var(--cap-edge));
  }
  .skill-key-cap {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    border-radius: clamp(.26rem, .65vw, .65rem);
    background: radial-gradient(ellipse at 65% 85%, var(--cap-dark), transparent 76%), var(--cap-light);
    border: 1px solid rgb(255 249 237 / .32);
    box-shadow: inset 0 1px rgb(255 252 242 / .42), inset 0 -3px rgb(0 0 0 / .16);
    transform: translateZ(var(--cap-height));
    transition: box-shadow .2s ease;
  }
  .skill-key-cap img {
    width: 62%;
    height: 62%;
    object-fit: contain;
    filter: brightness(0) invert(1);
  }
  .skill-key[data-skill-logo="oracle"] img { width: 78%; }
  .skill-key:is([aria-pressed="true"], :hover, :focus-visible) .skill-key-cap {
    box-shadow: inset 0 0 0 2px #f9e7c9, 0 0 .65rem rgb(218 177 126 / .5);
  }
  .skill-key:focus-visible { outline-offset: 3px; }
  .skill-key:is([data-hovered], [data-pressed]) .skill-key-mechanism {
    transform: translateZ(calc(var(--cap-height) * -.65));
    transition-duration: .045s;
  }

  .skill-detail {
    min-width: 0;
    min-height: 12rem;
    padding: .85rem 0 .65rem clamp(.75rem, 1.8vw, 1.6rem);
    border-inline-start: 1px solid var(--rule);
  }
  .skill-detail h3 {
    margin: .28em 0 .22em;
    font-size: clamp(2.3rem, 4.75vw, 5rem);
    line-height: .91;
    overflow-wrap: anywhere;
    text-wrap: balance;
  }
  .skill-detail-meta { display: flex; align-items: center; gap: .75rem; }
  .skill-detail-meta kbd {
    display: grid;
    place-items: center;
    min-width: 1.45rem;
    min-height: 1.45rem;
    border: 1px solid var(--rule);
    border-radius: .22rem;
    color: var(--muted);
    font: .67rem ui-monospace, monospace;
  }
  .skill-description { font-size: clamp(.82rem, 1.2vw, 1rem); }

  .keyboard-hint-touch { display: none; }
  @media (max-width: 1023px), (hover: none) and (pointer: coarse) {
    .skills-layout { grid-template-columns: 1fr; gap: .6rem; }
    .keyboard-scene {
      --keyboard-columns: 6;
      --keyboard-pitch: 20deg;
      --keyboard-yaw: -5deg;
      --keyboard-roll: -3deg;
      width: min(100%, 31rem);
      margin-inline: auto;
      padding: .75rem .25rem 1.35rem;
    }
    .skill-key { --cap-pocket: 2px; aspect-ratio: 1.19; min-height: 2.75rem; }
    .skill-detail { min-height: 8rem; }
  }
  @media (hover: none) {
    .keyboard-hint-pointer { display: none; }
    .keyboard-hint-touch { display: inline; }
  }
  @media (prefers-reduced-motion: reduce) {
    .keyboard-scene { --keyboard-tilt-x: 0deg !important; --keyboard-tilt-y: 0deg !important; }
  }
</style>
