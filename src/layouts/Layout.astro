---
import LiveChat from "../components/LiveChat.astro";
import { desktopPresentation } from "../scripts/portfolio-layout";

interface Props {
  title?: string;
  description?: string;
}
const {
  title = "Pablo Montero | Software Engineer",
  description = "Portafolio de Pablo Montero, desarrollador full stack enfocado en arquitectura de sistemas y desarrollo de productos.",
} = Astro.props;

const navigation = [
  { href: "#about", key: "nav.about", label: "Sobre mí" },
  { href: "#projects", key: "nav.projects", label: "Proyectos" },
  { href: "#certificates", key: "nav.certificates", label: "Certificados" },
  { href: "#skills", key: "nav.skills", label: "Habilidades" },
  { href: "#contact", key: "nav.contact", label: "Contacto" },
];
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <script define:vars={{ desktopPresentation }}>
      if (!location.hash && matchMedia(desktopPresentation).matches && matchMedia("(prefers-reduced-motion: no-preference)").matches) {
        document.documentElement.dataset.openingPending = "";
        setTimeout(() => { delete document.documentElement.dataset.openingPending; }, 1600);
      }
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header" data-site-header>
      <div class="site-frame site-bar">
        <a class="brand display" href="#inicio">Pablo Montero</a>
        <nav class="desktop-nav" aria-label="Portafolio">
          {navigation.map(({ href, key, label }) => <a href={href} data-i18n={key}>{label}</a>)}
        </nav>
        <div class="site-tools">
          <LiveChat />
          <button type="button" data-language-toggle data-i18n-aria="language.aria" aria-label="Cambiar idioma a inglés"><span data-language-label>English</span></button>
          <details class="mobile-nav" data-mobile-nav>
            <summary><span data-i18n="nav.menu">Menú</span> <span aria-hidden="true">+</span></summary>
            <nav aria-label="Portafolio">
              {navigation.map(({ href, key, label }) => <a href={href} data-i18n={key}>{label}</a>)}
            </nav>
          </details>
        </div>
      </div>
    </header>
    <main><slot /></main>
    <script>
      import "../scripts/animations";
      import "../scripts/navbar";
      import "../scripts/i18n";
    </script>
  </body>
</html>
<style>
  .site-header {
    --nav-glass: blur(4px);
    --nav-glass-edge: 1px solid rgb(255 255 255 / .095);
    position: fixed;
    inset: 0 0 auto;
    z-index: 10;
    text-shadow: 0 1px 5px rgb(16 14 13 / .55);
  }
  .site-header::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    backdrop-filter: var(--nav-glass);
    border-block-end: var(--nav-glass-edge);
  }
  :global(html[data-opening-pending]) .site-header { visibility: hidden; }
  .site-bar { min-height: 4.6rem; display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .brand { font-size: clamp(1.25rem, 2vw, 1.7rem); white-space: nowrap; }
  .desktop-nav, .site-tools { display: flex; align-items: center; gap: clamp(.8rem, 2.5vw, 2.7rem); }
  .desktop-nav a, .site-tools button, summary { font-size: .73rem; font-weight: 600; }
  .desktop-nav a { text-transform: capitalize; }
  .site-bar a:hover, .site-tools button:hover, summary:hover { color: var(--gold); }
  .mobile-nav { display: none; }
  .mobile-nav summary { list-style: none; cursor: pointer; }
  .mobile-nav summary::-webkit-details-marker { display: none; }
  .mobile-nav nav {
    position: absolute;
    inset: 100% 0 auto;
    display: grid;
    backdrop-filter: var(--nav-glass);
    border-block-end: var(--nav-glass-edge);
    padding: .6rem var(--gutter) 1rem;
  }
  .mobile-nav nav a { padding-block: .85rem; border-bottom: 1px solid var(--rule); text-transform: capitalize; }
  @media (max-width: 1023px), (hover: none) {
    .desktop-nav { display: none; }
    .mobile-nav { display: block; }
    .site-bar { min-height: 4rem; }
    .site-tools button, .mobile-nav summary { min-height: 2.75rem; display: flex; align-items: center; gap: .25rem; }
    .mobile-nav nav { max-height: calc(100dvh - 4rem); overflow-y: auto; }
  }
  @media (max-width: 390px) {
    .site-bar { gap: .4rem; padding-inline: .75rem; }
    .site-tools { gap: .5rem; }
    .brand { font-size: 1.14rem; }
  }
</style>
